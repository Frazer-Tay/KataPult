rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validNewLearner(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'learner'
        && request.resource.data.xp == 0
        && request.resource.data.streak == 0
        && request.resource.data.level == 1;
    }

    function validLearnerProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'username',
        'displayName',
        'photoURL',
        'xp',
        'streak',
        'level',
        'lastActiveDate',
        'dailyChallengeStatus',
        'lastDailyChallengeDate'
      ])
      && request.resource.data.uid == resource.data.uid
      && request.resource.data.email == resource.data.email
      && request.resource.data.role == resource.data.role
      && request.resource.data.xp is int
      && request.resource.data.xp >= resource.data.xp
      && request.resource.data.xp <= resource.data.xp + 300
      && request.resource.data.streak is int
      && request.resource.data.streak >= 0
      && request.resource.data.streak <= resource.data.streak + 1
      && request.resource.data.level is int
      && request.resource.data.level >= 1
      && request.resource.data.level <= resource.data.level + 2;
    }

    function validActivityWrite() {
      return false;
    }

    function validActivityEventCreate() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.eventType in [
          'section_visit',
          'section_time',
          'session_time',
          'answer_attempt',
          'test_result',
          'xp_awarded'
        ]
        && request.resource.data.section is string
        && request.resource.data.section.size() >= 1
        && request.resource.data.section.size() <= 80
        && request.resource.data.route is string
        && request.resource.data.route.size() <= 200
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= 0
        && request.resource.data.durationSeconds <= 21600
        && (!('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 120))
        && (!('correct' in request.resource.data)
          || request.resource.data.correct is bool)
        && (!('itemType' in request.resource.data)
          || (request.resource.data.itemType is string
            && request.resource.data.itemType.size() <= 80))
        && (!('score' in request.resource.data)
          || (request.resource.data.score is int
            && request.resource.data.score >= 0
            && request.resource.data.score <= 1000))
        && (!('xpAmount' in request.resource.data)
          || (request.resource.data.xpAmount is int
            && request.resource.data.xpAmount >= 0
            && request.resource.data.xpAmount <= 500))
        && (!('completed' in request.resource.data)
          || request.resource.data.completed is bool)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'eventType',
          'section',
          'route',
          'durationSeconds',
          'correct',
          'itemType',
          'score',
          'xpAmount',
          'completed',
          'createdAt'
        ]);
    }

    function validFeedbackCreate() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'open'
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 3
        && request.resource.data.category.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 8
        && request.resource.data.message.size() <= 1000
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'category',
          'message',
          'route',
          'status',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validFeedbackAdminUpdate() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ])
        && request.resource.data.status in ['open', 'reviewed'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if validNewLearner(userId);
      allow update: if isOwner(userId) && validLearnerProfileUpdate();
      allow delete: if false;
    }

    match /learnerActivity/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if validActivityWrite();
      allow delete: if false;
    }

    match /activityEvents/{eventId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if validActivityEventCreate();
      allow update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if validFeedbackCreate();
      allow update: if validFeedbackAdminUpdate();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
