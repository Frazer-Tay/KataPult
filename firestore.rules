rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validNewLearner(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'learner'
        && request.resource.data.xp == 0
        && request.resource.data.streak == 0
        && request.resource.data.level == 1;
    }

    function validLearnerProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'username',
        'displayName',
        'photoURL',
        'xp',
        'streak',
        'level',
        'lastActiveDate',
        'dailyChallengeStatus',
        'lastDailyChallengeDate'
      ])
      && request.resource.data.uid == resource.data.uid
      && request.resource.data.email == resource.data.email
      && request.resource.data.role == resource.data.role
      && request.resource.data.xp is int
      && request.resource.data.xp >= resource.data.xp
      && request.resource.data.xp <= resource.data.xp + 300
      && request.resource.data.streak is int
      && request.resource.data.streak >= 0
      && request.resource.data.streak <= resource.data.streak + 1
      && request.resource.data.level is int
      && request.resource.data.level >= 1
      && request.resource.data.level <= resource.data.level + 2;
    }

    function validActivityWrite(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'lastSeenAt',
          'updatedAt',
          'lastRoute',
          'sectionVisitCount',
          'sectionTotals',
          'totalSectionSeconds',
          'sessionFlushCount',
          'totalSessionSeconds',
          'totalAttempts',
          'totalCorrect',
          'totalIncorrect',
          'questionTypeTotals',
          'testsCompleted',
          'totalScore',
          'xpEarned',
          'xpAwardCount'
        ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if validNewLearner(userId);
      allow update: if isOwner(userId) && validLearnerProfileUpdate();
      allow delete: if false;
    }

    match /learnerActivity/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if validActivityWrite(userId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
